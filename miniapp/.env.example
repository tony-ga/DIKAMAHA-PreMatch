TELEGRAM_BOT_TOKEN=
TELEGRAM_ACCESS_MODE=private
TELEGRAM_ALLOWED_USER_IDS=
DIKAMAHA_BOT_API_URL=https://dikamaha-prematch-production.up.railway.app
DIKAMAHA_API_KEY=
DATABASE_URL=
MINIAPP_SESSION_SECRET=
MINIAPP_ENABLED=false
MINIAPP_ALERTS_ENABLED=false
TELEGRAM_ALERT_POLL_SECONDS=30

# --- Cobro con Telegram Stars (Fase 125) ---
# Interruptor único. Con `false` nadie queda gateado y `resolveEntitlement`
# devuelve premium sin tocar la base: es el rollback de toda la fase.
MINIAPP_BILLING_ENABLED=false
# Secreto compartido bot <-> Mini App para los endpoints internos. Mínimo 32
# caracteres y sin valor por defecto: el servicio no arranca sin él.
MINIAPP_INTERNAL_API_KEY=
# Firma de los payloads de factura. Distinto del de sesión a propósito: el bot
# necesita éste y no debe poder falsificar una sesión.
MINIAPP_BILLING_SECRET=
# Sólo semilla de `billing_plans`. El precio vigente sale de la tabla, para
# poder ajustarlo sin redesplegar.
MINIAPP_PREMIUM_STARS_PRICE=250
MINIAPP_FREE_DAILY_PREDICTIONS=3
# Mismo huso que el track record diario (Fase 121).
MINIAPP_QUOTA_TIMEZONE=America/Mexico_City
# Sólo lo lee el worker de alertas.
MINIAPP_BILLING_RECONCILE_SECONDS=900
