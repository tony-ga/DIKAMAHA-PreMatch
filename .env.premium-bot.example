# Credenciales del bot privado. Nunca confirmes el archivo .env real.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ACCESS_MODE=private
TELEGRAM_ALLOWED_USER_IDS=123456789

# API DIKAMAHA desplegada; debe ser HTTPS y no terminar con "/".
DIKAMAHA_BOT_API_URL=https://dikamaha-prematch-production.up.railway.app
DIKAMAHA_API_KEY=

TELEGRAM_POLL_TIMEOUT=25
TELEGRAM_REQUEST_TIMEOUT=15
TELEGRAM_RATE_LIMIT=10
TELEGRAM_RATE_WINDOW_SECONDS=60
LOG_LEVEL=INFO

# --- Cobro con Telegram Stars (Fase 125) ---
# Apagado reproduce exactamente el bot previo a la fase.
TELEGRAM_BILLING_ENABLED=false
MINIAPP_INTERNAL_URL=https://<miniapp>.up.railway.app
# Ambos deben coincidir BYTE A BYTE con los del servicio telegram-miniapp. Un
# desajuste se manifiesta como "todos los pre-checkout rechazados", que parece
# un problema de Telegram y no lo es.
MINIAPP_INTERNAL_API_KEY=
MINIAPP_BILLING_SECRET=
