# Copiar estos valores al archivo .env local. Nunca versionar el token real.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_POLL_TIMEOUT=25
TELEGRAM_REQUEST_TIMEOUT=15
TELEGRAM_RATE_LIMIT=10
TELEGRAM_RATE_WINDOW_SECONDS=60
TELEGRAM_CHANNEL_ID=@viewtofuture
TELEGRAM_CHANNEL_POLL_SECONDS=300
# Interruptor: full publica todos; lite publica sólo los 3 primeros de mañana.
TELEGRAM_CHANNEL_MODE=full
TELEGRAM_CHANNEL_LEDGER_PATH=/data/telegram_channel.sqlite

# API DIKAMAHA local.
DIKAMAHA_BOT_API_URL=http://127.0.0.1:8000
DIKAMAHA_UPCOMING_LEAGUES=esp.1,eng.1,mex.1
# DIKAMAHA_API_KEY=definir_solo_si_la_API_tiene_auth
DIKAMAHA_AUTH_ENABLED=true
DIKAMAHA_API_KEY=
DIKAMAHA_MAX_CONCURRENT_REQUESTS=16
DIKAMAHA_RATE_LIMIT_REQUESTS=600
DIKAMAHA_INFERENCE_TIMEOUT_SECONDS=30
LOG_LEVEL=INFO
